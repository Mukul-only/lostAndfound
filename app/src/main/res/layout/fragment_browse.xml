<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/spotify_bg">

    <!-- Top Bar: search row + inline expandable filter panel -->
    <LinearLayout
        android:id="@+id/layoutBrowseTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/spotify_surface"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:elevation="2dp">

        <!-- Search row: search field + filter toggle button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/spotify_border"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/spotify_surface2">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_search"
                        app:tint="@color/spotify_text2" />

                    <!-- Height is minHeight, not a fixed 44dp: the field must grow with the
                         user's font scale instead of cropping descenders and
                         ascenders. includeFontPadding stays on so the glyph
                         box is the full Android default, and the row is taller
                         than the field so nothing clips. -->
                    <com.example.lostandfound.ui.components.FounditEditText
                        android:id="@+id/etBrowseSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:minHeight="44dp"
                        android:gravity="center_vertical"
                        android:background="@android:color/transparent"
                        android:hint="Search by keywords..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/spotify_text"
                        android:textSize="15sp"
                        android:textColorHint="@color/spotify_text2" />

                    <!-- Matches the field's min height so the row does not grow just because
                         the clear button is present. -->
                    <ImageButton
                        android:id="@+id/btnClearSearch"
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:minHeight="44dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/spotify_text2"
                        android:contentDescription="@string/content_description_clear" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <ImageButton
                    android:id="@+id/btnFilterToggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_filter"
                    android:tint="@color/spotify_text"
                    android:contentDescription="@string/browse_show_filters" />

                <View
                    android:id="@+id/viewFilterDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_circle_brand"
                    android:visibility="gone" />

            </FrameLayout>
        </LinearLayout>

        <!-- Inline expandable filter panel. Lifts off the #181818 bar with a
             #252525 surface (DESIGN.md Elevation level 2, "Dark Card") and a
             heavy shadow rather than a raw grey border, which DESIGN.md tells
             us not to expose. 12dp of space separates it from the search row
             above; nothing animates this margin, so it is safe to set. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutFilterPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardCornerRadius="10dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/spotify_card">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browse_filters_title"
                    android:textColor="@color/spotify_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browse_report_type"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupBrowseType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacing="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeAll"
                        style="@style/Widget.Foundit.Spotify.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/browse_type_all"
                        android:checked="true"
                        app:chipIcon="@drawable/ic_grid"
                        app:chipIconTint="@color/spotify_filter_text"
                        app:chipIconVisible="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeLost"
                        style="@style/Widget.Foundit.Spotify.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/browse_type_lost"
                        app:chipIcon="@drawable/ic_search"
                        app:chipIconTint="@color/spotify_filter_text"
                        app:chipIconVisible="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTypeFound"
                        style="@style/Widget.Foundit.Spotify.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/browse_type_found"
                        app:chipIcon="@drawable/ic_check"
                        app:chipIconTint="@color/spotify_filter_text"
                        app:chipIconVisible="true" />

                </com.google.android.material.chip.ChipGroup>

                <!-- The two buttons below show the CURRENT selection, not what
                     they do, so each needs its own label for hierarchy. -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/browse_category_label"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategoryFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/browse_all_categories"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_list"
                    app:iconGravity="start"
                    app:iconSize="20dp"
                    style="@style/Widget.Foundit.Spotify.OutlinedButton" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/browse_campus_label"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCampusFilter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/browse_all_campus"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:icon="@drawable/ic_location"
                    app:iconGravity="start"
                    app:iconSize="20dp"
                    style="@style/Widget.Foundit.Spotify.OutlinedButton" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Content & Refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshBrowse"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ProgressBar
                android:id="@+id/progressBrowse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/spotify_green"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutBrowseEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvBrowseEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="No reports found matching your filters."
                    android:textColor="@color/spotify_text2"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowseRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Retry"
                    android:textAllCaps="false"
                    style="@style/Widget.Foundit.Spotify.OutlinedButton" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBrowseReports"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="8dp"
                android:paddingBottom="112dp"
                android:clipToPadding="false" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>