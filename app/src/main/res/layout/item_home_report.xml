<?xml version="1.0" encoding="utf-8"?>
<!-- Home feed card — Spotify: #181818 surface, 8dp radius, heavy elevation.
     Photo (album-art color source) on top; white title, silver meta.
     Home-only: My Reports / Browse keep their own layouts. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    style="@style/Widget.Foundit.Spotify.Card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Poster row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/ivPosterAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_spotify_avatar"
                android:src="@drawable/ic_person"
                android:tint="@color/spotify_text2"
                android:padding="8dp"
                android:contentDescription="@string/content_description_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPosterName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Campus Student"
                    android:textColor="@color/spotify_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvPostedTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sep 28, 2026"
                    android:textColor="@color/spotify_text2"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:minWidth="48dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="LOST"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:maxLines="1" />

        </LinearLayout>

        <!-- Photo: full color source, uncropped -->
        <ImageView
            android:id="@+id/ivItemImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:minHeight="160dp"
            android:background="@color/spotify_surface2"
            android:src="@drawable/ic_photo"
            android:contentDescription="@string/content_description_photo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Item Title"
                android:textColor="@color/spotify_text"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvDescriptionPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Description preview"
                android:textColor="@color/spotify_text3"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp" />

            <!-- Metadata: location + category packed LEFT (packed chain,
                 bias 0); View details pinned to the row END outside the
                 chain. Location is width-capped by its constraints so long
                 text ellipsizes instead of shoving the category right. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="4dp">

                <ImageView
                    android:id="@+id/ivLocationIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location"
                    android:tint="@color/spotify_text2"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvLocation"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintHorizontal_chainStyle="packed"
                    app:layout_constraintHorizontal_bias="0" />

                <TextView
                    android:id="@+id/tvLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Library"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintStart_toEndOf="@id/ivLocationIcon"
                    app:layout_constraintEnd_toStartOf="@id/tvSeparator"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvSeparator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:text="·"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:importantForAccessibility="no"
                    app:layout_constraintStart_toEndOf="@id/tvLocation"
                    app:layout_constraintEnd_toStartOf="@id/ivCategoryIcon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <ImageView
                    android:id="@+id/ivCategoryIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_cat_other"
                    android:tint="@color/spotify_text2"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    app:layout_constraintStart_toEndOf="@id/tvSeparator"
                    app:layout_constraintEnd_toStartOf="@id/tvCategory"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Electronics"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:layout_constraintStart_toEndOf="@id/ivCategoryIcon"
                    app:layout_constraintEnd_toStartOf="@id/tvViewDetails"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <TextView
                    android:id="@+id/tvViewDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/report_opens_detail"
                    android:textAllCaps="true"
                    android:textColor="@color/spotify_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:contentDescription="@string/report_opens_detail"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

<TextView
                  android:id="@+id/tvStatusBadge"
                  android:layout_width="wrap_content"
                  android:layout_height="28dp"
                  android:gravity="center_vertical"
                  android:paddingStart="14dp"
                  android:paddingEnd="14dp"
                  android:layout_marginTop="4dp"
                  android:text="Open"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:maxLines="1"
                  android:background="@drawable/bg_spotify_status" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
