<?xml version="1.0" encoding="utf-8"?>
<!-- Centered conversation event: "Alex accepted the handover location."
     Server-authorized, so the name in it is the actor the backend recorded, not
     text a client typed. Tappable so the reader can jump to the exact proposal
     the event answers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/layoutEventPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_chat_event"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:minHeight="48dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivEventIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_chat_event_accept"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvEventText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/spotify_text"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
