<?xml version="1.0" encoding="utf-8"?>
<!-- One settings row: icon, title, description, chevron. Included five times by
     fragment_settings with different ids, so every option shares identical
     spacing and touch target (>=48dp) instead of drifting apart. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/ivSettingsRowIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:tint="@color/spotify_green"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSettingsRowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/spotify_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSettingsRowDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/spotify_text2"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivSettingsRowChevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_arrow_back"
        android:tint="@color/spotify_text2"
        android:rotation="180"
        android:contentDescription="@null" />
</LinearLayout>