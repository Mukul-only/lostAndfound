<?xml version="1.0" encoding="utf-8"?>
<!-- FOUNDIT Home — Spotify redesign (DESIGN.md): near-black immersion (#121212),
     #181818 cards, #1f1f1f pills, green (#1ed760) functional-only.
     Pill search + pill CTAs + circular avatar. No light surfaces. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/spotify_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="112dp">

            <!-- Header (top inset applied at runtime) -->
            <LinearLayout
                android:id="@+id/layoutHomeHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_hero_title"
                        android:textAppearance="@style/TextAppearance.Foundit.Spotify.SectionTitle"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_hero_subtitle"
                        android:textAppearance="@style/TextAppearance.Foundit.Spotify.Caption"
                        android:maxLines="1"
                        android:ellipsize="end" />

                </LinearLayout>

                <!-- Profile entry: circular photo, initials, or default glyph. -->
                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <!-- No oval background or border: the photo is cropped to
                         a circle by Glide and sits straight on the header. -->
<ImageButton
                          android:id="@+id/btnAvatar"
                          android:layout_width="match_parent"
                          android:layout_height="match_parent"
                          android:background="?attr/selectableItemBackgroundBorderless"
                          android:scaleType="centerCrop"
                          android:src="@drawable/ic_person"
                          android:tint="@color/spotify_text2"
                          android:padding="14dp"
                          android:contentDescription="@string/nav_profile" />
              </FrameLayout>

            </LinearLayout>

            <!-- Pill search -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                style="@style/Widget.Foundit.Spotify.SearchCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_search"
                        android:tint="@color/spotify_text2"
                        android:importantForAccessibility="no" />

                    <com.example.lostandfound.ui.components.FounditEditText
                        android:id="@+id/etHomeSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:layout_marginStart="10dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/home_search_hint"
                        android:textColor="@color/spotify_text"
                        android:textColorHint="@color/spotify_text2"
                        android:textSize="16sp"
                        android:inputType="text"
                        android:imeOptions="actionSearch"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="end" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Dual LOST / FOUND pills (uppercase via style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLost"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/report_type_lost"
                    app:icon="@drawable/ic_luggage"
                    app:iconSize="18dp"
                    app:iconPadding="8dp"
                    style="@style/Widget.Foundit.Spotify.DarkPill" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFound"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/report_type_found"
                    app:icon="@drawable/ic_briefcase"
                    app:iconSize="18dp"
                    app:iconPadding="8dp"
                    style="@style/Widget.Foundit.Spotify.GreenPill" />

            </LinearLayout>

            <!-- Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_categories_header"
                    android:textAppearance="@style/TextAppearance.Foundit.Spotify.FeatureHeading"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvClearCategoryFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/content_description_clear"
                    android:textColor="@color/spotify_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp"
                    android:visibility="gone" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal" />

            <!-- Report feed header + functional-green filters -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:text="@string/home_recent_header"
                android:textAppearance="@style/TextAppearance.Foundit.Spotify.FeatureHeading"
                android:maxLines="1"
                android:ellipsize="end" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:clipToPadding="false"
                android:paddingBottom="4dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupReportFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacing="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterAll"
                        style="@style/Widget.Foundit.Spotify.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_filter_all"
                        android:checked="true" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterFoundRecently"
                        style="@style/Widget.Foundit.Spotify.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_filter_found_recently" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFilterStillLost"
                        style="@style/Widget.Foundit.Spotify.FilterChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_filter_still_lost" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <ProgressBar
                android:id="@+id/progressHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"
                android:indeterminateTint="@color/spotify_green"
                android:visibility="gone" />

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutHomeEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_photo"
                    android:tint="@color/spotify_text2"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/tvHomeEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/home_empty_state"
                    android:textColor="@color/spotify_text2"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>

            <!-- Error state -->
            <LinearLayout
                android:id="@+id/layoutHomeError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="40dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvHomeError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/spotify_error"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHomeRetry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/home_retry"
                    style="@style/Widget.Foundit.Spotify.DarkPill" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingTop="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
