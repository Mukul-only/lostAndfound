<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tileCard"
    android:layout_width="@dimen/category_tile_width"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/spacing_sm"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/home_hairline"
    app:cardBackgroundColor="@color/home_canvas">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="@dimen/spacing_md">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="@dimen/category_icon_container_size"
            android:layout_height="@dimen/category_icon_container_size"
            android:background="@drawable/bg_avatar_circle">

            <ImageView
                android:id="@+id/ivIcon"
                android:layout_width="@dimen/category_icon_size"
                android:layout_height="@dimen/category_icon_size"
                android:layout_gravity="center"
                android:contentDescription="@string/content_description_category" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center"
            android:textColor="@color/home_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>