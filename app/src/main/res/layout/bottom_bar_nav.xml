<?xml version="1.0" encoding="utf-8"?>
<!-- Shared bottom navigation shell (DESIGN.md mobile bar + Home: near-black
     #121212, white active / silver inactive, hairline divider). Included
     id-less by activity_main (views merge into its binding). Styling and
     routing stay single-sourced here + MainActivity. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_bar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/nav_background">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/spotify_border" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        style="@style/Widget.App.BottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav_background"
        app:elevation="0dp"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>