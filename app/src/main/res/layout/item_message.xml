<?xml version="1.0" encoding="utf-8"?>
<!-- One text message. Sent is right-aligned with a green bubble and black text;
     received is left-aligned with a #1F1F1F bubble and white text. That single
     colour + alignment difference is the only sender cue, per the design
     system. Grouped consecutive messages hide the repeated avatar and tighten
     their spacing so a run reads as one block.

     A quoted reply renders inside the bubble, above the new text: the bubble
     grew to a vertical stack so the quote sits in the same rounded surface as
     the words it answers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">

    <!-- Outgoing (me) -->
    <LinearLayout
        android:id="@+id/layoutOutMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|bottom"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/columnOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:id="@+id/bubbleOut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_chat_out">

                <include
                    android:id="@+id/quoteOut"
                    layout="@layout/view_chat_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvOutContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/spotify_on_green"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOutTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/spotify_text2"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Hidden on grouped consecutive messages. -->
        <ImageView
            android:id="@+id/ivOutAvatar"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_avatar_circle"
            android:padding="5dp"
            android:src="@drawable/ic_person"
            android:contentDescription="@null" />
    </LinearLayout>

    <!-- Incoming (them) -->
    <LinearLayout
        android:id="@+id/layoutInMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|bottom"
        android:paddingTop="1dp"
        android:paddingBottom="1dp"
        android:visibility="gone">

        <!-- Hidden on grouped consecutive messages. -->
        <ImageView
            android:id="@+id/ivInAvatar"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_avatar_circle"
            android:padding="5dp"
            android:src="@drawable/ic_person"
            android:contentDescription="@null" />

        <LinearLayout
            android:id="@+id/columnIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:id="@+id/tvInSenderName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:textColor="@color/spotify_text2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/bubbleIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_chat_in">

                <include
                    android:id="@+id/quoteIn"
                    layout="@layout/view_chat_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvInContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/spotify_text"
                    android:textSize="15sp"
                    android:lineSpacingMultiplier="1.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvInTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/spotify_text2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
