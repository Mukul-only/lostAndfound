<?xml version="1.0" encoding="utf-8"?>
<!-- Photo source chooser. Two equal icon+label cards instead of a plain text
     list, so the source is obvious at a glance. Follows the design system:
     near-black surfaces, 8dp card radius, white primary / silver secondary,
     and no decorative green. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:paddingBottom="4dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:id="@+id/tvPhotoSourceTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/report_photo_source_title"
        android:textColor="@color/spotify_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvPhotoSourceSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/photo_source_subtitle"
        android:textColor="@color/spotify_text2"
        android:textSize="13sp" />

    <!-- Gallery -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardChooseGallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/spotify_surface2"
        app:strokeColor="@color/spotify_border"
        app:strokeWidth="1dp"
        app:rippleColor="@color/spotify_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gallery"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Choose from gallery"
                    android:textColor="@color/spotify_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pick an existing image"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Camera -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTakePhoto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/spotify_surface2"
        app:strokeColor="@color/spotify_border"
        app:strokeWidth="1dp"
        app:rippleColor="@color/spotify_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_camera"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Take photo"
                    android:textColor="@color/spotify_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use your camera"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Borderless: TextButton supplies no stroke; only the text goes red. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelPhotoSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="8dp"
        android:minWidth="96dp"
        android:minHeight="48dp"
        android:paddingHorizontal="24dp"
        android:text="Cancel"
        android:textAllCaps="true"
        android:textColor="@color/spotify_error"
        android:letterSpacing="0.08"
        android:textSize="13sp"
        style="@style/Widget.Foundit.Spotify.TextButton" />

</LinearLayout>
