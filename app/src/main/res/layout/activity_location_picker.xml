<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/spotify_bg">

    <!-- Top Bar & Safety Notice Container -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:elevation="4dp"
        android:background="@color/spotify_surface">

        <!-- Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
            android:id="@+id/btnPickerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/spotify_text"
            android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPickerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pin Item Location"
                    android:textColor="@color/spotify_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPickerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap or drag pin to place where item was found"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Campus Safety Warning Notice Banner -->
        <LinearLayout
            android:id="@+id/layoutSafetyNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/spotify_surface2"
            android:padding="10dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/spotify_text2"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvSafetyNoticeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Campus Safety: Choose a public campus spot (e.g. Library, Quad, or Dining Hall). Never pin dorm rooms or private residences."
                android:textColor="@color/spotify_text2"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Map Container: Takes ALL available vertical space -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <fragment
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Optional Floating "My Location" Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMyLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:contentDescription="Locate Me"
            android:src="@drawable/ic_my_location"
            app:backgroundTint="@color/spotify_surface2"
            app:tint="@color/spotify_green"
            app:fabSize="mini" />
    </FrameLayout>

    <!-- Bottom Action Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/spotify_surface"
        app:strokeColor="@color/spotify_border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Selected Coordinates Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/spotify_green"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvSelectedCoordinates"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tap map to set pin location"
                    android:textColor="@color/spotify_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Optional handover note input (visible only in propose mode) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMeetingNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/location_handover_note_hint"
                app:helperText="e.g. Front entrance benches near the fountain"
                app:helperTextTextColor="@color/spotify_text2"
                android:visibility="gone"
                style="@style/Widget.Foundit.Spotify.TextInputLayout">

                <com.example.lostandfound.ui.components.FounditTextInputEditText
                    android:id="@+id/etMeetingNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="250"
                    android:maxLines="2" 
                    android:textColor="@color/spotify_text" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirm Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="Confirm Location"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textSize="13sp"
                app:icon="@drawable/ic_check"
                style="@style/Widget.Foundit.Spotify.GreenPill" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseViewOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="Close Map"
                android:textAllCaps="false"
                android:visibility="gone"
                style="@style/Widget.Foundit.Spotify.OutlinedButton" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
