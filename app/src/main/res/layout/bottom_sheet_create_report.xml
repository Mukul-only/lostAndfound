<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="24dp"
    android:layout_marginTop="8dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create a Report"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What would you like to report?"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:layout_marginBottom="20dp" />

    <!-- I Lost Something -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLostSomething"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginBottom="12dp"
        android:text="@string/fab_lost"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_report_problem"
        app:iconGravity="start"
        app:iconSize="22dp"
        app:cornerRadius="28dp"
        style="@style/Widget.App.Button.Secondary" />

    <!-- I Found Something -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFoundSomething"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:text="@string/fab_found"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        app:icon="@drawable/ic_add"
        app:iconGravity="start"
        app:iconSize="22dp"
        app:cornerRadius="28dp"
        style="@style/Widget.App.Button.Primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Both options include optional campus map pin for location"
        android:textColor="@color/text_muted"
        android:textSize="11sp" />

</LinearLayout>