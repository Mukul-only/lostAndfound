<?xml version="1.0" encoding="utf-8"?>
<!-- Report Details. DESIGN.md hierarchy, top to bottom:
       photo (or a real no-photo state) -> title + LOST/FOUND + status ->
       description -> category / location / date-time / reporter ->
       map (only with coordinates) -> verification -> actions.

     Surfaces: page #121212, cards #181818 at 8dp with no stroke
     (DESIGN.md: "No visible borders on most cards"). Borders appear only where
     they carry meaning. Every text row is width=0dp + weight=1 so it wraps
     instead of clipping when the user scales text up. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/spotify_bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top bar: identity only. Safety report sits here as a quiet dark
             circle rather than a loud filled button. -->
        <LinearLayout
            android:id="@+id/layoutDetailToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/spotify_surface"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:elevation="2dp">

            <ImageButton
                android:id="@+id/btnDetailBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/spotify_text"
                android:contentDescription="@string/detail_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/detail_title"
                android:textColor="@color/spotify_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Safety-report entry: a bare icon, no container and no border, with a
                 circular ripple on press only. 48dp target. Visitors only; the
                 owner has no way to report their own post. -->
            <ImageButton
                android:id="@+id/btnReportPost"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button_ripple"
                android:padding="13dp"
                android:src="@drawable/ic_report_problem"
                app:tint="@color/spotify_error"
                android:contentDescription="@string/detail_report_inappropriate" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/spotify_green"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- ============ 1. Photo, or a deliberate no-photo state ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDetailPhoto"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="@color/spotify_surface2">

                <ImageView
                    android:id="@+id/ivDetailPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/detail_photo" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/layoutNoPhoto"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_no_photo"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_photo"
                    app:tint="@color/spotify_outline"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/detail_no_photo"
                    android:textColor="@color/spotify_text2"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- ============ 2. Title and state ============ -->
            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_title"
                android:textColor="@color/spotify_text"
                android:textSize="24sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/tvDetailTypeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="24dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/detail_lost_item"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/spotify_error"
                    android:background="@drawable/bg_spotify_badge_lost"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvDetailStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="@string/detail_status_open"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="@color/spotify_green"
                    android:background="@drawable/bg_status_pill" />

            </LinearLayout>

            <!-- ============ 3. Description ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detail_description"
                android:textColor="@color/spotify_text"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detail_description_placeholder"
                android:textColor="@color/spotify_text"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginBottom="20dp" />

            <!-- ============ 4. Category / location / date / reporter ============ -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                style="@style/Widget.Foundit.Spotify.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:id="@+id/ivDetailCategoryIcon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_cat_other"
                            app:tint="@color/spotify_text2"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvDetailCategory"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_category"
                            android:textColor="@color/spotify_text"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/spotify_text2"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvDetailLocation"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_location"
                            android:textColor="@color/spotify_text"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/spotify_text2"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvDetailDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_date"
                            android:textColor="@color/spotify_text"
                            android:textSize="15sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/spotify_text2"
                            android:layout_marginEnd="12dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/tvDetailOwner"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_reported_by"
                            android:textColor="@color/spotify_text2"
                            android:textSize="14sp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 5. Map, only when the report has coordinates ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFoundMapLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                style="@style/Widget.Foundit.Spotify.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="10dp">

                        <TextView
                            android:id="@+id/tvMapCardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_map_last_seen"
                            android:textColor="@color/spotify_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvOpenMapFullscreen"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/detail_view_map"
                            android:textColor="@color/spotify_text"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textAllCaps="true"
                            android:letterSpacing="0.08"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:focusable="true" />

                    </LinearLayout>

                    <fragment
                        android:id="@+id/mapDetailView"
                        android:name="com.google.android.gms.maps.SupportMapFragment"
                        android:layout_width="match_parent"
                        android:layout_height="180dp" />

                    <TextView
                        android:id="@+id/tvDetailPinCoordinates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="14dp"
                        android:text="@string/detail_pin_note"
                        android:textColor="@color/spotify_text2"
                        android:textSize="12sp"
                        android:lineSpacingExtra="2dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 6. Finder's public verification question (FOUND only) ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPublicQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                style="@style/Widget.Foundit.Spotify.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp"
                    android:baselineAligned="false">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/question_mark_24"
                        app:tint="@color/spotify_text2"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/content_description_claim_question" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_verification_question"
                            android:textColor="@color/spotify_text2"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                        <TextView
                            android:id="@+id/tvPublicQuestionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/detail_question_placeholder"
                            android:textColor="@color/spotify_text"
                            android:textSize="16sp"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 7. Finder's secret detail. OWNER ONLY, never to visitors. ============ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPrivateSecretNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                style="@style/Widget.Foundit.Spotify.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/spotify_text2"
                            android:layout_marginEnd="10dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_secret_detail"
                            android:textColor="@color/spotify_text2"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textAllCaps="true" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPrivateNoteText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/detail_secret_placeholder"
                        android:textColor="@color/spotify_text"
                        android:textSize="15sp"
                        android:lineSpacingExtra="3dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============ 8. Owner actions ============ -->
            <LinearLayout
                android:id="@+id/layoutOwnerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/detail_owner_actions"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textAllCaps="true"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReviewClaims"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/detail_review_claims"
                    android:textAllCaps="false"
                    style="@style/Widget.Foundit.Spotify.GreenPill" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMarkReturned"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="@string/detail_mark_returned"
                        android:textAllCaps="false"
                        style="@style/Widget.Foundit.Spotify.OutlinedButton" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCloseReport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:text="@string/detail_close_report"
                        android:textAllCaps="false"
                        style="@style/Widget.Foundit.Spotify.DangerOutline" />

                </LinearLayout>

            </LinearLayout>

            <!-- ============ 9. Visitor actions and claim states ============ -->
            <LinearLayout
                android:id="@+id/layoutVisitorActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRespondOrClaim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/detail_claim_item"
                    android:textAllCaps="false"
                    style="@style/Widget.Foundit.Spotify.GreenPill" />

                <!-- Pending -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardClaimStatusPending"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    style="@style/Widget.Foundit.Spotify.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_claim_pending"
                            android:textColor="@color/spotify_warning"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/detail_claim_pending_body"
                            android:textColor="@color/spotify_text2"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Accepted -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardClaimStatusAccepted"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    style="@style/Widget.Foundit.Spotify.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_claim_accepted"
                            android:textColor="@color/spotify_green"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:text="@string/detail_claim_accepted_body"
                            android:textColor="@color/spotify_text2"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenChatAccepted"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_open_chat"
                            android:textAllCaps="false"
                            style="@style/Widget.Foundit.Spotify.GreenPill" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Rejected -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardClaimStatusRejected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone"
                    style="@style/Widget.Foundit.Spotify.Card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_claim_rejected"
                            android:textColor="@color/spotify_error"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvClaimStatusRejectedText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/detail_claim_rejected_body"
                            android:textColor="@color/spotify_text2"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp" />

                        <!-- Owner's private reason: visually separated from the
                             status above so it reads as a distinct note. -->
                        <TextView
                            android:id="@+id/tvClaimStatusRejectedNote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:padding="12dp"
                            android:text="@string/detail_claim_rejected_note"
                            android:textColor="@color/spotify_error"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"
                            android:background="@color/spotify_surface2"
                            android:visibility="gone" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvNotOpenNotice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:text="@string/detail_not_open"
                    android:textColor="@color/spotify_text2"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:background="@color/spotify_surface2"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
