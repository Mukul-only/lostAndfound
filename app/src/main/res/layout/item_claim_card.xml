<?xml version="1.0" encoding="utf-8"?>
<!-- Claim / response card — Spotify: #181818 surface, 8dp radius, heavy
     elevation. Type hierarchy does the work: bold white name, silver meta,
     near-white answer. Green is reserved for the accepted state only.
     The question/answer pair is deliberately bare — no panel, no border, no
     background — separated by their icons alone. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp"
    style="@style/Widget.Foundit.Spotify.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Who + when + state -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivClaimantAvatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person"
                android:padding="8dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/content_description_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvClaimantName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Student Claimant"
                    android:textColor="@color/spotify_text"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tvClaimDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Submitted Sep 28, 2026"
                    android:textColor="@color/spotify_text2"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvClaimStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:gravity="center"
                android:minWidth="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="PENDING"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/spotify_warning"
                android:maxLines="1"
                android:background="@drawable/bg_spotify_status" />

        </LinearLayout>

        <!-- Q/A. No background, no border, no label text: the icons alone
             distinguish them, and each icon carries a contentDescription so
             TalkBack conveys the same distinction. -->
        <LinearLayout
            android:id="@+id/layoutClaimQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/question_mark_24"
                android:tint="@color/spotify_text2"
                android:contentDescription="@string/content_description_claim_question" />

            <TextView
                android:id="@+id/tvClaimQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="What is written on the base?"
                android:textColor="@color/spotify_text"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="4"
                android:ellipsize="end" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutClaimAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_reply"
                android:tint="@color/spotify_text2"
                android:contentDescription="@string/content_description_claim_answer" />

            <TextView
                android:id="@+id/tvClaimEvidence"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Evidence or response note…"
                android:textColor="@color/spotify_text3"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:maxLines="6"
                android:ellipsize="end" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvClaimRejectionReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Owner note: Details did not match"
            android:textColor="@color/spotify_error"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

        <!-- Actions (owner review on PENDING, or Open Chat once accepted) -->
        <LinearLayout
            android:id="@+id/layoutClaimActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRejectClaim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/claim_decline"
                android:textAllCaps="false"
                style="@style/Widget.Foundit.Spotify.DangerOutline"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptClaim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/claim_accept_and_chat"
                android:textAllCaps="false"
                style="@style/Widget.Foundit.Spotify.GreenPill" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>