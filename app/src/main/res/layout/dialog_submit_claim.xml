<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <TextView
        android:id="@+id/tvClaimDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit Claim / Response"
        android:textColor="@color/spotify_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvClaimPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Provide evidence or details to verify ownership."
        android:textColor="@color/spotify_text2"
        android:textSize="13sp" />

    <!-- Question Box (Visible if Found report has a public question) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDialogQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/spotify_info"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="@color/spotify_surface"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verification Question:"
                android:textColor="@color/spotify_info"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Question text..."
                android:textColor="@color/spotify_text"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Your Private Evidence / Description"
        style="@style/Widget.Foundit.Spotify.TextInputLayout">

        <com.example.lostandfound.ui.components.FounditTextInputEditText
            android:id="@+id/etClaimEvidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3" 
            android:textColor="@color/spotify_text" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Your response is private and only visible to the report owner."
        android:textColor="@color/spotify_text2"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvClaimError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/spotify_error"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitClaim"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="16dp"
        android:text="Submit Verification Response"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:textSize="13sp"
        style="@style/Widget.Foundit.Spotify.GreenPill" />

    <ProgressBar
        android:id="@+id/progressSubmitClaim"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:indeterminateTint="@color/spotify_green"
        android:visibility="gone" />
</LinearLayout>
