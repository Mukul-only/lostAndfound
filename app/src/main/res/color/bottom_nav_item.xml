<?xml version="1.0" encoding="utf-8"?>
<!-- ColorStateList for bottom navigation icon tint and text color.
     Selected → primary navy; all other states → muted slate gray -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/nav_selected" />
    <item android:color="@color/nav_unselected" />
</selector>
