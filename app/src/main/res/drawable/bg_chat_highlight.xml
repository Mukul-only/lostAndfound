<?xml version="1.0" encoding="utf-8"?>
<!-- Jump-to target flash. Darks surface at 40% so the row's own content stays
     readable, with a green outline so the flash is unmistakable on the dark
     canvas. Same alpha convention as spotify_highlight. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="10dp" />
    <solid android:color="#662A2A2A" />
    <stroke android:width="2dp" android:color="@color/spotify_green" />
</shape>
