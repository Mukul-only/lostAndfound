<?xml version="1.0" encoding="utf-8"?>
<!-- Status pill on dark: #1f1f1f fill with a gray stroke; text is set
     per-status in code (green/amber/blue/silver). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="100dp" />
    <solid android:color="@color/spotify_surface2" />
    <stroke
        android:width="1dp"
        android:color="@color/spotify_border" />
</shape>
