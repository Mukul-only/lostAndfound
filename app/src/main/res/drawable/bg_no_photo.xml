<?xml version="1.0" encoding="utf-8"?>
<!-- No-photo state for Report Details: a recessed interactive surface
     (DESIGN.md #1f1f1f) at the standard 8dp card radius, with a subtle inset
     border so the empty area still reads as a deliberate slot rather than a
     hole in the page. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="@color/spotify_surface2" />
    <stroke
        android:width="1dp"
        android:color="@color/spotify_border" />
</shape>
