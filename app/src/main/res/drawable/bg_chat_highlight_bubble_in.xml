<?xml version="1.0" encoding="utf-8"?>
<!-- Jump-to flash for a RECEIVED bubble: an outline in the bubble's own shape.
     Used as a FOREGROUND so the bubble's background and padding are never
     replaced, which keeps the text from shifting for the length of the flash. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomLeftRadius="2dp"
        android:bottomRightRadius="16dp" />
    <solid android:color="#1AFFFFFF" />
    <stroke
        android:width="2dp"
        android:color="#FFFFFFFF" />
</shape>
