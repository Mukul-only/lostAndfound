<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral supporting-note container (DESIGN.md border token): #1f1f1f
     fill, gray outline. For informational notes — not errors, which keep
     their amber/red voice. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/spotify_surface2" />
    <corners android:radius="12dp" />
    <stroke
        android:width="1dp"
        android:color="@color/spotify_border" />
</shape>
