<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown option list surface. Must stay rounded AND unclipped: the rows
     inside are transparent so these corners are what shows. DESIGN.md radius
     scale puts overlay elements at "Medium (10px-20px)" and lists dropdown
     menus as an elevated overlay, so 12dp sits inside that band. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/spotify_surface" />
</shape>
