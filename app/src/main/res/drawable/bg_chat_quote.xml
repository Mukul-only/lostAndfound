<?xml version="1.0" encoding="utf-8"?>
<!-- Quote surface. Inherits its own darker shade so it reads as a nested layer
     inside a bubble and inside the composer without relying on a raw border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="6dp" />
    <solid android:color="@color/spotify_chat_quote_bg" />
</shape>
